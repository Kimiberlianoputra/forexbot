# ── Twelve Data ──────────────────────────────────────────────
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here

# ── Telegram ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456789:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_CHAT_ID=987654321

# ── Data mode ────────────────────────────────────────────────
# websocket = stream ticks, build candles locally (recommended)
# rest      = poll the time_series endpoint
DATA_MODE=websocket

# REST only: poll interval in seconds
REST_POLL_SECONDS=60

# REST only: only poll during these UTC hours (e.g. "8-21" for London+NY)
REST_POLL_HOURS_UTC=0-23

# ── Strategy (optional overrides) ────────────────────────────
# EMA_PERIOD=100
# RSI_PERIOD=3
# ADX_PERIOD=5
# RSI_OVERSOLD=20
# RSI_OVERBOUGHT=80
# ADX_THRESHOLD=30
# BODY_RATIO_MIN=0.5
# BODY_RATIO_MAX=1.5

# ── Trade plan (added 2026-10-29) ────────────────────────────
# Fixed-dollar mode (default, matches the original spec)
TP_DOLLARS=7.50
SL_DOLLARS=5.00
# Set TP_SL_MODE=atr for volatility-scaled targets:
#   TP = TP_ATR_MULT x ATR(ATR_PERIOD), SL = SL_ATR_MULT x ATR
TP_SL_MODE=fixed
ATR_PERIOD=14
TP_ATR_MULT=1.5
SL_ATR_MULT=1.0
MIN_SL_DOLLARS=1.0

# ── Signal gating (added 2026-10-29) ─────────────────────────
ENABLE_BUY=true
ENABLE_SELL=true
# Suppress signals within N seconds of the previous one (0 = off)
SIGNAL_COOLDOWN_SECONDS=300
# Re-verify every signal against REST candles before alerting
# (catches phantom candles from sparse free-tier WS ticks; 1 credit/signal)
CONFIRM_WITH_REST=true
# Minimum ticks a candle must see to be trusted (websocket mode)
MIN_TICKS_PER_CANDLE=2
