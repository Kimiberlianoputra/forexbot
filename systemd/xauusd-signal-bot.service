[Unit]
Description=XAU/USD Signal Bot
Documentation=file:%h/xauusd-signal-bot/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/xauusd-signal-bot
EnvironmentFile=%h/xauusd-signal-bot/.env
ExecStart=%h/xauusd-signal-bot/venv/bin/python %h/xauusd-signal-bot/main.py
Restart=on-failure
RestartSec=10

# Logging goes to the user journal
StandardOutput=journal
StandardError=journal

# Hardening (optional, safe for this bot)
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
