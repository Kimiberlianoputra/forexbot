[Unit]
Description=XAU/USD Signal Bot
Documentation=file://__PROJECT_DIR__/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__PROJECT_DIR__
EnvironmentFile=__PROJECT_DIR__/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=__PROJECT_DIR__/venv/bin/python __PROJECT_DIR__/main.py
Restart=always
RestartSec=10

# Logging goes to the user journal
StandardOutput=journal
StandardError=journal

# Hardening (optional, safe for this bot)
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
